---
import { siteConfig } from "../config";
const hasPersonal =
  siteConfig.personal && siteConfig.personal.interests.length > 0;
---

{
  hasPersonal && (
    <section id="personal" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Más allá del código
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8 space-y-8">
            <p class="text-lg sm:text-xl md:text-2xl leading-relaxed text-gray-600">
              {siteConfig.personal.intro}
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-6">
              {siteConfig.personal.interests.map((interest) => (
                <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4 sm:p-5 md:p-6 hover:shadow-md transition-shadow duration-300">
                  <span class="text-3xl" aria-hidden="true">
                    {interest.emoji}
                  </span>
                  <h3 class="mt-3 text-lg sm:text-xl font-semibold text-gray-900">
                    {interest.title}
                  </h3>
                  <p class="mt-1 text-sm sm:text-base text-gray-600">
                    {interest.description}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
