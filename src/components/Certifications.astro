---
import { siteConfigs, ui, type Lang } from "../config";
import SectionHeading from "./SectionHeading.astro";

const { lang = "es" } = Astro.props as { lang?: Lang };
const siteConfig = siteConfigs[lang];
const t = ui[lang];
const hasCertifications =
  siteConfig.certifications && siteConfig.certifications.length > 0;
---

{
  hasCertifications && (
    <section id="certifications" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <SectionHeading text={t.certifications} />

          <div class="lg:col-span-8">
            <ul class="bg-white dark:bg-gray-900 rounded-lg shadow-sm border border-gray-100 dark:border-gray-800 divide-y divide-gray-100 dark:divide-gray-800">
              {siteConfig.certifications.map((cert) => (
                <li class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 sm:gap-4 p-4 sm:p-5">
                  <div>
                    {cert.url ? (
                      <a
                        href={cert.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-lg sm:text-xl font-semibold text-gray-900 dark:text-gray-100 underline decoration-2 underline-offset-4 hover:opacity-80 transition-opacity"
                        style="text-decoration-color: var(--accent)"
                      >
                        {cert.name}
                      </a>
                    ) : (
                      <span class="text-lg sm:text-xl font-semibold text-gray-900 dark:text-gray-100">
                        {cert.name}
                      </span>
                    )}
                    {cert.credentialId && (
                      <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mt-1">
                        {t.credentialId}: {cert.credentialId}
                      </p>
                    )}
                  </div>
                  <span class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap">
                    {cert.date}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )
}
